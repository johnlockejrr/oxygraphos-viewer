ALLOWED_ROOT=/home/youruser
# Optional: first folder shown when opening the directory browser (GET /api/dirs with no path).
# Must be inside ALLOWED_ROOT. Example: /home/you/AI/DATASETS
# BROWSE_START_PATH=
# Thumbnail JPEG cache (default: system temp, e.g. /tmp/pageviewer/thumbs). Use an absolute path if you prefer.
# THUMB_CACHE_DIR=
THUMB_SIZE=150
PAGE_SIZE=20
MAX_PAGE_SIZE=100
DIR_BROWSER_PAGE_SIZE=50
MAX_DIR_BROWSER_PAGE_SIZE=200
OVERLAY_CACHE_SIZE=50
# Comma-separated origins for CORS (dev includes Vite default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: path to SvelteKit `build` output for production single-server deploy
# FRONTEND_DIST=
